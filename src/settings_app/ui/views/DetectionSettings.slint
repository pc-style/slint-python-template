import { SliderGroup } from "../components/SliderGroup.slint";
import { CheckboxGroup } from "../components/CheckboxGroup.slint";

export component DetectionSettings inherits ScrollView {
    // Properties for all detection settings
    in-out property <float> detection_threshold_x: 3;
    in-out property <float> detection_threshold_y: 3;
    in-out property <float> upper_color_r: 154;
    in-out property <float> upper_color_g: 165;
    in-out property <float> upper_color_b: 175;
    in-out property <float> lower_color_r: 141;
    in-out property <float> lower_color_g: 88;
    in-out property <float> lower_color_b: 58;
    in-out property <float> min_contour_area: 261;
    in-out property <float> density_threshold: 0.5;
    in-out property <bool> enable_clustering: true;
    in-out property <float> cluster_distance: 40;
    in-out property <float> min_cluster_size: 1000;
    in-out property <float> max_cluster_size: 20000;
    in-out property <float> fov_x: 400;
    in-out property <float> fov_y: 400;
    in-out property <float> aim_fov_x: 400;
    in-out property <float> aim_fov_y: 400;
    in-out property <float> fps: 120;
    in-out property <bool> auto_detect_resolution: true;
    in-out property <float> resolution_x: 1920;
    in-out property <float> resolution_y: 1080;
    
    // Callbacks
    callback detection_threshold_x_changed(float);
    callback detection_threshold_y_changed(float);
    callback upper_color_r_changed(float);
    callback upper_color_g_changed(float);
    callback upper_color_b_changed(float);
    callback lower_color_r_changed(float);
    callback lower_color_g_changed(float);
    callback lower_color_b_changed(float);
    callback min_contour_area_changed(float);
    callback density_threshold_changed(float);
    callback enable_clustering_changed(bool);
    callback cluster_distance_changed(float);
    callback min_cluster_size_changed(float);
    callback max_cluster_size_changed(float);
    callback fov_x_changed(float);
    callback fov_y_changed(float);
    callback aim_fov_x_changed(float);
    callback aim_fov_y_changed(float);
    callback fps_changed(float);
    callback auto_detect_resolution_changed(bool);
    callback resolution_x_changed(float);
    callback resolution_y_changed(float);
    
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        
        // Detection Threshold Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Detection Threshold";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "Threshold X";
                    value <=> root.detection_threshold_x;
                    minimum: 0;
                    maximum: 10;
                    
                    value_changed(val) => {
                        root.detection_threshold_x_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Threshold Y";
                    value <=> root.detection_threshold_y;
                    minimum: 0;
                    maximum: 10;
                    
                    value_changed(val) => {
                        root.detection_threshold_y_changed(val);
                    }
                }
            }
        }
        
        // Color Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Color Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                Text {
                    text: "Upper Color (RGB)";
                    font-weight: 600;
                    color: #34495e;
                }
                
                SliderGroup {
                    label: "Red";
                    value <=> root.upper_color_r;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.upper_color_r_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Green";
                    value <=> root.upper_color_g;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.upper_color_g_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Blue";
                    value <=> root.upper_color_b;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.upper_color_b_changed(val);
                    }
                }
                
                Text {
                    text: "Lower Color (RGB)";
                    font-weight: 600;
                    color: #34495e;
                }
                
                SliderGroup {
                    label: "Red";
                    value <=> root.lower_color_r;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.lower_color_r_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Green";
                    value <=> root.lower_color_g;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.lower_color_g_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Blue";
                    value <=> root.lower_color_b;
                    minimum: 0;
                    maximum: 255;
                    
                    value_changed(val) => {
                        root.lower_color_b_changed(val);
                    }
                }
            }
        }
        
        // Contour and Clustering Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Contour & Clustering";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "Min Contour Area";
                    value <=> root.min_contour_area;
                    minimum: 0;
                    maximum: 1000;
                    unit: " px²";
                    
                    value_changed(val) => {
                        root.min_contour_area_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Density Threshold";
                    value <=> root.density_threshold;
                    minimum: 0;
                    maximum: 1;
                    
                    value_changed(val) => {
                        root.density_threshold_changed(val);
                    }
                }
                
                CheckboxGroup {
                    label: "Enable Clustering";
                    checked <=> root.enable_clustering;
                    
                    toggled(val) => {
                        root.enable_clustering_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Cluster Distance";
                    value <=> root.cluster_distance;
                    minimum: 0;
                    maximum: 100;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.cluster_distance_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Min Cluster Size";
                    value <=> root.min_cluster_size;
                    minimum: 0;
                    maximum: 5000;
                    unit: " px²";
                    
                    value_changed(val) => {
                        root.min_cluster_size_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Max Cluster Size";
                    value <=> root.max_cluster_size;
                    minimum: 5000;
                    maximum: 50000;
                    unit: " px²";
                    
                    value_changed(val) => {
                        root.max_cluster_size_changed(val);
                    }
                }
            }
        }
        
        // Field of View Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Field of View";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "FOV X";
                    value <=> root.fov_x;
                    minimum: 100;
                    maximum: 1000;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.fov_x_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "FOV Y";
                    value <=> root.fov_y;
                    minimum: 100;
                    maximum: 1000;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.fov_y_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Aim FOV X";
                    value <=> root.aim_fov_x;
                    minimum: 100;
                    maximum: 1000;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.aim_fov_x_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Aim FOV Y";
                    value <=> root.aim_fov_y;
                    minimum: 100;
                    maximum: 1000;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.aim_fov_y_changed(val);
                    }
                }
            }
        }
        
        // Display Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Display Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "FPS";
                    value <=> root.fps;
                    minimum: 30;
                    maximum: 240;
                    unit: " fps";
                    
                    value_changed(val) => {
                        root.fps_changed(val);
                    }
                }
                
                CheckboxGroup {
                    label: "Auto Detect Resolution";
                    checked <=> root.auto_detect_resolution;
                    
                    toggled(val) => {
                        root.auto_detect_resolution_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Resolution X";
                    value <=> root.resolution_x;
                    minimum: 800;
                    maximum: 3840;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.resolution_x_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Resolution Y";
                    value <=> root.resolution_y;
                    minimum: 600;
                    maximum: 2160;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.resolution_y_changed(val);
                    }
                }
            }
        }
    }
}