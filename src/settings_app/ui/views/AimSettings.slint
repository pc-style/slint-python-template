import { SliderGroup } from "../components/SliderGroup.slint";
import { CheckboxGroup } from "../components/CheckboxGroup.slint";
import { ComboBoxGroup } from "../components/ComboBoxGroup.slint";

export component AimSettings inherits ScrollView {
    // Properties for all aim settings
    in-out property <float> aim_offset: 0;
    in-out property <float> aim_smooth: 0.9;
    in-out property <float> aim_speed: 0.5;
    in-out property <float> aim_y_speed: 0.2;
    in-out property <float> aim_height: 0.7;
    in-out property <string> smoothing_type: "bezier";
    in-out property <float> ease_factor: 2.0;
    in-out property <float> min_ease_speed: 0.2;
    in-out property <float> bezier_control_offset: 0.3;
    in-out property <float> bezier_tension: 1.0;
    in-out property <float> movement_randomness: 0.1;
    in-out property <float> deadzone: 10;
    in-out property <bool> enable_anti_shake: true;
    in-out property <float> anti_shake_threshold: 0.05;
    in-out property <float> shake_suppression_factor: 0.7;
    in-out property <float> shake_escalation_threshold: 0.2;
    in-out property <float> shake_escalation_rate: 0.1;
    in-out property <float> shake_cooldown_duration: 2.0;
    
    // Callbacks
    callback aim_offset_changed(float);
    callback aim_smooth_changed(float);
    callback aim_speed_changed(float);
    callback aim_y_speed_changed(float);
    callback aim_height_changed(float);
    callback smoothing_type_changed(string);
    callback ease_factor_changed(float);
    callback min_ease_speed_changed(float);
    callback bezier_control_offset_changed(float);
    callback bezier_tension_changed(float);
    callback movement_randomness_changed(float);
    callback deadzone_changed(float);
    callback enable_anti_shake_changed(bool);
    callback anti_shake_threshold_changed(float);
    callback shake_suppression_factor_changed(float);
    callback shake_escalation_threshold_changed(float);
    callback shake_escalation_rate_changed(float);
    callback shake_cooldown_duration_changed(float);
    
    VerticalLayout {
        padding: 20px;
        spacing: 20px;
        
        // Basic Aim Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Basic Aim Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "Aim Offset";
                    value <=> root.aim_offset;
                    minimum: -50;
                    maximum: 50;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.aim_offset_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Smoothing";
                    value <=> root.aim_smooth;
                    minimum: 0.1;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.aim_smooth_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Base Speed";
                    value <=> root.aim_speed;
                    minimum: 0.1;
                    maximum: 2.0;
                    
                    value_changed(val) => {
                        root.aim_speed_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Y Speed";
                    value <=> root.aim_y_speed;
                    minimum: 0.1;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.aim_y_speed_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Aim Height";
                    value <=> root.aim_height;
                    minimum: 0.1;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.aim_height_changed(val);
                    }
                }
            }
        }
        
        // Smoothing Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Smoothing Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                ComboBoxGroup {
                    label: "Smoothing Type";
                    current_value <=> root.smoothing_type;
                    model: ["linear", "ease_in_out", "bezier"];
                    
                    selected(value) => {
                        root.smoothing_type_changed(value);
                    }
                }
                
                SliderGroup {
                    label: "Ease Factor";
                    value <=> root.ease_factor;
                    minimum: 1.0;
                    maximum: 5.0;
                    
                    value_changed(val) => {
                        root.ease_factor_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Min Ease Speed";
                    value <=> root.min_ease_speed;
                    minimum: 0.0;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.min_ease_speed_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Bézier Control Offset";
                    value <=> root.bezier_control_offset;
                    minimum: 0.0;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.bezier_control_offset_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Bézier Tension";
                    value <=> root.bezier_tension;
                    minimum: 0.1;
                    maximum: 2.0;
                    
                    value_changed(val) => {
                        root.bezier_tension_changed(val);
                    }
                }
            }
        }
        
        // Movement Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Movement Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                SliderGroup {
                    label: "Movement Randomness";
                    value <=> root.movement_randomness;
                    minimum: 0.0;
                    maximum: 0.5;
                    
                    value_changed(val) => {
                        root.movement_randomness_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Deadzone";
                    value <=> root.deadzone;
                    minimum: 0;
                    maximum: 50;
                    unit: " px";
                    
                    value_changed(val) => {
                        root.deadzone_changed(val);
                    }
                }
            }
        }
        
        // Anti-Shake Settings Section
        Rectangle {
            background: #f8f9fa;
            border-radius: 8px;
            
            VerticalLayout {
                padding: 15px;
                spacing: 10px;
                
                Text {
                    text: "Anti-Shake Settings";
                    font-size: 18px;
                    font-weight: 700;
                    color: #2c3e50;
                }
                
                CheckboxGroup {
                    label: "Enable Anti-Shake";
                    checked <=> root.enable_anti_shake;
                    
                    toggled(val) => {
                        root.enable_anti_shake_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Anti-Shake Threshold";
                    value <=> root.anti_shake_threshold;
                    minimum: 0.01;
                    maximum: 0.2;
                    
                    value_changed(val) => {
                        root.anti_shake_threshold_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Shake Suppression Factor";
                    value <=> root.shake_suppression_factor;
                    minimum: 0.1;
                    maximum: 1.0;
                    
                    value_changed(val) => {
                        root.shake_suppression_factor_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Shake Escalation Threshold";
                    value <=> root.shake_escalation_threshold;
                    minimum: 0.1;
                    maximum: 0.5;
                    
                    value_changed(val) => {
                        root.shake_escalation_threshold_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Shake Escalation Rate";
                    value <=> root.shake_escalation_rate;
                    minimum: 0.05;
                    maximum: 0.3;
                    
                    value_changed(val) => {
                        root.shake_escalation_rate_changed(val);
                    }
                }
                
                SliderGroup {
                    label: "Shake Cooldown Duration";
                    value <=> root.shake_cooldown_duration;
                    minimum: 0.5;
                    maximum: 10.0;
                    unit: " sec";
                    
                    value_changed(val) => {
                        root.shake_cooldown_duration_changed(val);
                    }
                }
            }
        }
    }
}