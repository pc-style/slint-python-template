import { Button, TabWidget } from "std-widgets.slint";
import { DetectionSettings } from "views/DetectionSettings.slint";
import { AimSettings } from "views/AimSettings.slint";

export component SettingsWindow inherits Window {
    in-out property <[int]> size;
    in-out property <[int]> maxSize;
    
    // Detection properties
    in-out property <float> detection_threshold_x: 3;
    in-out property <float> detection_threshold_y: 3;
    in-out property <float> upper_color_r: 154;
    in-out property <float> upper_color_g: 165;
    in-out property <float> upper_color_b: 175;
    in-out property <float> lower_color_r: 141;
    in-out property <float> lower_color_g: 88;
    in-out property <float> lower_color_b: 58;
    in-out property <float> min_contour_area: 261;
    in-out property <float> density_threshold: 0.5;
    in-out property <bool> enable_clustering: true;
    in-out property <float> cluster_distance: 40;
    in-out property <float> min_cluster_size: 1000;
    in-out property <float> max_cluster_size: 20000;
    in-out property <float> fov_x: 400;
    in-out property <float> fov_y: 400;
    in-out property <float> aim_fov_x: 400;
    in-out property <float> aim_fov_y: 400;
    in-out property <float> fps: 120;
    in-out property <bool> auto_detect_resolution: true;
    in-out property <float> resolution_x: 1920;
    in-out property <float> resolution_y: 1080;
    
    // Aim properties
    in-out property <float> aim_offset: 0;
    in-out property <float> aim_smooth: 0.9;
    in-out property <float> aim_speed: 0.5;
    in-out property <float> aim_y_speed: 0.2;
    in-out property <float> aim_height: 0.7;
    in-out property <string> smoothing_type: "bezier";
    in-out property <float> ease_factor: 2.0;
    in-out property <float> min_ease_speed: 0.2;
    in-out property <float> bezier_control_offset: 0.3;
    in-out property <float> bezier_tension: 1.0;
    in-out property <float> movement_randomness: 0.1;
    in-out property <float> deadzone: 10;
    in-out property <bool> enable_anti_shake: true;
    in-out property <float> anti_shake_threshold: 0.05;
    in-out property <float> shake_suppression_factor: 0.7;
    in-out property <float> shake_escalation_threshold: 0.2;
    in-out property <float> shake_escalation_rate: 0.1;
    in-out property <float> shake_cooldown_duration: 2.0;
    
    private property <string> status_message: "Ready";
    
    // Callbacks for detection settings
    callback detection_threshold_x_changed(float);
    callback detection_threshold_y_changed(float);
    callback upper_color_r_changed(float);
    callback upper_color_g_changed(float);
    callback upper_color_b_changed(float);
    callback lower_color_r_changed(float);
    callback lower_color_g_changed(float);
    callback lower_color_b_changed(float);
    callback min_contour_area_changed(float);
    callback density_threshold_changed(float);
    callback enable_clustering_changed(bool);
    callback cluster_distance_changed(float);
    callback min_cluster_size_changed(float);
    callback max_cluster_size_changed(float);
    callback fov_x_changed(float);
    callback fov_y_changed(float);
    callback aim_fov_x_changed(float);
    callback aim_fov_y_changed(float);
    callback fps_changed(float);
    callback auto_detect_resolution_changed(bool);
    callback resolution_x_changed(float);
    callback resolution_y_changed(float);
    
    // Callbacks for aim settings
    callback aim_offset_changed(float);
    callback aim_smooth_changed(float);
    callback aim_speed_changed(float);
    callback aim_y_speed_changed(float);
    callback aim_height_changed(float);
    callback smoothing_type_changed(string);
    callback ease_factor_changed(float);
    callback min_ease_speed_changed(float);
    callback bezier_control_offset_changed(float);
    callback bezier_tension_changed(float);
    callback movement_randomness_changed(float);
    callback deadzone_changed(float);
    callback enable_anti_shake_changed(bool);
    callback anti_shake_threshold_changed(float);
    callback shake_suppression_factor_changed(float);
    callback shake_escalation_threshold_changed(float);
    callback shake_escalation_rate_changed(float);
    callback shake_cooldown_duration_changed(float);
    
    // File operation callbacks
    callback save_settings_callback() -> string;
    callback load_settings_callback() -> string;
    callback reset_to_defaults_callback();
    
    default-font-size: 14px;
    
    min-width: size[0] * 1px;
    min-height: size[1] * 1px;
    max-width: maxSize[0] * 1px;
    max-height: maxSize[1] * 1px;
    title: "Settings Configuration";
    
    VerticalLayout {
        padding: 10px;
        spacing: 10px;
        
        // Header with action buttons
        Rectangle {
            background: #34495e;
            border-radius: 8px;
            height: 60px;
            
            HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                alignment: center;
                
                Text {
                    text: "Settings Configuration";
                    font-size: 20px;
                    font-weight: 700;
                    color: white;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                Button {
                    text: "Load Settings";
                    
                    clicked => {
                        root.status_message = root.load_settings_callback();
                    }
                }
                
                Button {
                    text: "Save Settings";
                    primary: true;
                    
                    clicked => {
                        root.status_message = root.save_settings_callback();
                    }
                }
                
                Button {
                    text: "Reset to Defaults";
                    
                    clicked => {
                        root.reset_to_defaults_callback();
                        root.status_message = "Settings reset to defaults";
                    }
                }
            }
        }
        
        // Main content with tabs
        TabWidget {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            
            Tab {
                title: "Detection Settings";
                
                DetectionSettings {
                    // Bind all detection properties
                    detection_threshold_x <=> root.detection_threshold_x;
                    detection_threshold_y <=> root.detection_threshold_y;
                    upper_color_r <=> root.upper_color_r;
                    upper_color_g <=> root.upper_color_g;
                    upper_color_b <=> root.upper_color_b;
                    lower_color_r <=> root.lower_color_r;
                    lower_color_g <=> root.lower_color_g;
                    lower_color_b <=> root.lower_color_b;
                    min_contour_area <=> root.min_contour_area;
                    density_threshold <=> root.density_threshold;
                    enable_clustering <=> root.enable_clustering;
                    cluster_distance <=> root.cluster_distance;
                    min_cluster_size <=> root.min_cluster_size;
                    max_cluster_size <=> root.max_cluster_size;
                    fov_x <=> root.fov_x;
                    fov_y <=> root.fov_y;
                    aim_fov_x <=> root.aim_fov_x;
                    aim_fov_y <=> root.aim_fov_y;
                    fps <=> root.fps;
                    auto_detect_resolution <=> root.auto_detect_resolution;
                    resolution_x <=> root.resolution_x;
                    resolution_y <=> root.resolution_y;
                    
                    // Forward all callbacks
                    detection_threshold_x_changed(val) => { root.detection_threshold_x_changed(val); }
                    detection_threshold_y_changed(val) => { root.detection_threshold_y_changed(val); }
                    upper_color_r_changed(val) => { root.upper_color_r_changed(val); }
                    upper_color_g_changed(val) => { root.upper_color_g_changed(val); }
                    upper_color_b_changed(val) => { root.upper_color_b_changed(val); }
                    lower_color_r_changed(val) => { root.lower_color_r_changed(val); }
                    lower_color_g_changed(val) => { root.lower_color_g_changed(val); }
                    lower_color_b_changed(val) => { root.lower_color_b_changed(val); }
                    min_contour_area_changed(val) => { root.min_contour_area_changed(val); }
                    density_threshold_changed(val) => { root.density_threshold_changed(val); }
                    enable_clustering_changed(val) => { root.enable_clustering_changed(val); }
                    cluster_distance_changed(val) => { root.cluster_distance_changed(val); }
                    min_cluster_size_changed(val) => { root.min_cluster_size_changed(val); }
                    max_cluster_size_changed(val) => { root.max_cluster_size_changed(val); }
                    fov_x_changed(val) => { root.fov_x_changed(val); }
                    fov_y_changed(val) => { root.fov_y_changed(val); }
                    aim_fov_x_changed(val) => { root.aim_fov_x_changed(val); }
                    aim_fov_y_changed(val) => { root.aim_fov_y_changed(val); }
                    fps_changed(val) => { root.fps_changed(val); }
                    auto_detect_resolution_changed(val) => { root.auto_detect_resolution_changed(val); }
                    resolution_x_changed(val) => { root.resolution_x_changed(val); }
                    resolution_y_changed(val) => { root.resolution_y_changed(val); }
                }
            }
            
            Tab {
                title: "Aim Settings";
                
                AimSettings {
                    // Bind all aim properties
                    aim_offset <=> root.aim_offset;
                    aim_smooth <=> root.aim_smooth;
                    aim_speed <=> root.aim_speed;
                    aim_y_speed <=> root.aim_y_speed;
                    aim_height <=> root.aim_height;
                    smoothing_type <=> root.smoothing_type;
                    ease_factor <=> root.ease_factor;
                    min_ease_speed <=> root.min_ease_speed;
                    bezier_control_offset <=> root.bezier_control_offset;
                    bezier_tension <=> root.bezier_tension;
                    movement_randomness <=> root.movement_randomness;
                    deadzone <=> root.deadzone;
                    enable_anti_shake <=> root.enable_anti_shake;
                    anti_shake_threshold <=> root.anti_shake_threshold;
                    shake_suppression_factor <=> root.shake_suppression_factor;
                    shake_escalation_threshold <=> root.shake_escalation_threshold;
                    shake_escalation_rate <=> root.shake_escalation_rate;
                    shake_cooldown_duration <=> root.shake_cooldown_duration;
                    
                    // Forward all callbacks
                    aim_offset_changed(val) => { root.aim_offset_changed(val); }
                    aim_smooth_changed(val) => { root.aim_smooth_changed(val); }
                    aim_speed_changed(val) => { root.aim_speed_changed(val); }
                    aim_y_speed_changed(val) => { root.aim_y_speed_changed(val); }
                    aim_height_changed(val) => { root.aim_height_changed(val); }
                    smoothing_type_changed(val) => { root.smoothing_type_changed(val); }
                    ease_factor_changed(val) => { root.ease_factor_changed(val); }
                    min_ease_speed_changed(val) => { root.min_ease_speed_changed(val); }
                    bezier_control_offset_changed(val) => { root.bezier_control_offset_changed(val); }
                    bezier_tension_changed(val) => { root.bezier_tension_changed(val); }
                    movement_randomness_changed(val) => { root.movement_randomness_changed(val); }
                    deadzone_changed(val) => { root.deadzone_changed(val); }
                    enable_anti_shake_changed(val) => { root.enable_anti_shake_changed(val); }
                    anti_shake_threshold_changed(val) => { root.anti_shake_threshold_changed(val); }
                    shake_suppression_factor_changed(val) => { root.shake_suppression_factor_changed(val); }
                    shake_escalation_threshold_changed(val) => { root.shake_escalation_threshold_changed(val); }
                    shake_escalation_rate_changed(val) => { root.shake_escalation_rate_changed(val); }
                    shake_cooldown_duration_changed(val) => { root.shake_cooldown_duration_changed(val); }
                }
            }
        }
        
        // Status bar
        Rectangle {
            background: #ecf0f1;
            border-radius: 4px;
            height: 30px;
            
            HorizontalLayout {
                padding: 8px;
                
                Text {
                    text: root.status_message;
                    color: #2c3e50;
                    vertical-alignment: center;
                }
            }
        }
    }
}